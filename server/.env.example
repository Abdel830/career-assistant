# Google Gemini API Key (get it free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# MySQL Database (Aiven / Railway / Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=career_assistant
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Server & CORS
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-vercel-frontend-domain.vercel.app
